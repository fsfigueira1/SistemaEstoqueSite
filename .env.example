# Banco de dados
#
# Supabase — use o "Transaction pooler" (porta 6543): multiplexa conexões.
# Project Settings → Database → Connection string → Transaction pooler
# DATABASE_URL="postgresql://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:6543/postgres?pgbouncer=true"
#
# Dev offline: `npx prisma dev` e cole a URL postgres:// que ele imprime.
DATABASE_URL=

CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

OWNER_PASSWORD=owner123
EMPLOYEE_PASSWORD=emp123

# --- Só no deploy público (Vercel), a PWA de consulta ---
# Liga a trava de escrita: nenhuma rota não-GET responde, exceto o cron.
# READ_ONLY=1
# PIN de leitura distribuído pro celular (papel VIEWER). Não defina no Electron.
# VIEWER_PIN=
# Secret do Vercel Cron. A Vercel manda "Authorization: Bearer <isto>" no cron.
# CRON_SECRET=
