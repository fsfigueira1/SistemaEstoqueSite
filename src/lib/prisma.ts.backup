// Shared PrismaClient instance to prevent SQLite_BUSY errors with multiple connections
import { PrismaClient, Prisma } from "../generated/prisma/client"

// Determine database URL based on environment
const databaseUrl = process.env.NODE_ENV === 'test'
  ? "file:./test.db"
  : "file:./dev.db";

// Create adapter and PrismaClient instance
let prisma: any;

if (process.env.NODE_ENV === 'test') {
  // In test environment, use standard PrismaClient with BetterSqlite3 adapter
  prisma = new PrismaClient({
    adapter: new PrismaBetterSqlite3(databaseUrl)
  });
} else {
  // In development/production, use the better sqlite3 adapter
  try {
    const { PrismaBetterSqlite3 } = require("@prisma/adapter-better-sqlite3");
    const adapter = new PrismaBetterSqlite3({ url: databaseUrl });
    prisma = new PrismaClient({ adapter });
  } catch (error) {
    // Fallback to standard PrismaClient if adapter is not available
    console.warn('Could not load PrismaBetterSqlite3 adapter, falling back to standard PrismaClient');
    prisma = new PrismaClient({
      datasourceUrl: databaseUrl
    });
  }
}

export { prisma };

// Export Prisma namespace for types
export { Prisma };

// Export types for convenience
export * from "../generated/prisma/client";