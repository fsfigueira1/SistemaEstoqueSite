{
  "name": "lacolaria-erp",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "seed": "node --experimental-strip-types prisma/seed.ts",
    "seed:demo": "node --experimental-strip-types src/seed/seed.ts",
    "db:migrate": "prisma migrate deploy",
    "db:from-sqlite": "node --experimental-strip-types scripts/migrate-sqlite-to-postgres.ts",
    "electron": "electron .",
    "electron:dev": "electron .",
    "electron:build": "next build && node scripts/prepare-standalone.cjs && electron-builder --win nsis",
    "electron:publish": "next build && node scripts/prepare-standalone.cjs && electron-builder --win nsis --publish always",
    "electron:release": "electron-builder --publish=always",
    "electron:pack": "electron-builder --win nsis --dir"
  },
  "dependencies": {
    "@alloc/quick-lru": "^5.3.0",
    "@base-ui/react": "^1.7.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-slot": "^1.3.3",
    "@supabase/server": "^1.5.3",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.115.0",
    "@tanstack/react-table": "^9.0.1",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.10.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.9",
    "framer-motion": "^13.0.0",
    "lucide-react": "^1.30.0",
    "next": "16.3.0",
    "next-themes": "^0.4.6",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "quagga": "^0.6.16",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.84.0",
    "recharts": "^3.10.1",
    "shadcn": "^4.16.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@prisma/client": "^7.9.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "next-auth": "^4.24.15",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "^5",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "com.lacolaria.gestao",
    "productName": "Laçolaria",
    "directories": {
      "output": "C:\\Users\\silva\\lacolaria-dist\\release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "fsfigueira1",
        "repo": "SistemaEstoqueSite",
        "releaseType": "release"
      }
    ],
    "asar": true,
    "files": [
      "electron/**",
      "public/icon.*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "electron/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    },
    "npmRebuild": false,
    "afterPack": "scripts/after-pack.cjs"
  },
  "description": "Sistema de gestão e PDV da papelaria Laçolaria",
  "author": "Laçolaria"
}
