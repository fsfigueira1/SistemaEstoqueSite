generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      String          @id @default(uuid())
  name                    String
  email                   String          @unique
  password                String
  role                    Role
  status                  UserStatus      @default(ACTIVE)
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  auditLogs               AuditLog[]      @relation("AuditLogUser")
  cashMovementsCreated    CashMovement[]  @relation("CashMovementCreatedBy")
  cashSessionsClosed      CashSession[]   @relation("CashSessionClosedBy")
  cashSessionsOpened      CashSession[]   @relation("CashSessionOpenedBy")
  priceHistoryChanged     PriceHistory[]  @relation("PriceHistoryChangedBy")
  purchaseOrdersUpdated   PurchaseOrder[] @relation("PurchaseOrderUpdatedBy")
  purchaseOrdersCreated   PurchaseOrder[] @relation("PurchaseOrderCreatedBy")
  salesCreated            Sale[]          @relation("SaleCreatedBy")
  salePaymentsProcessed   SalePayment[]   @relation("SalePaymentProcessedBy")
  stockMovementsPerformed StockMovement[] @relation("StockMovementPerformedBy")
  @@index([email])
}

model Category {
  id          String    @id @default(uuid())
  name        String
  description String?
  icon        String?   @default("Tag")
  color       String?   @default("#6B7280")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[] @relation("CategoryProducts")
  @@index([name])
}

model Supplier {
  id             String          @id @default(uuid())
  name           String
  contactName    String?
  email          String?
  phone          String?
  address        String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  products       Product[]       @relation("SupplierProducts")
  purchaseOrders PurchaseOrder[] @relation("SupplierPurchaseOrders")
  @@index([name])
}

model CashRegister {
  id          String        @id @default(uuid())
  name        String
  description String?
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  sessions    CashSession[] @relation("CashRegisterSessions")
  @@index([name])
}

model CashSession {
  id             String            @id @default(uuid())
  cashRegisterId String
  openedById     String
  openedAt       DateTime
  openingAmount  Decimal
  closedById     String?
  closedAt       DateTime?
  expectedAmount Decimal?
  countedAmount  Decimal?
  difference     Decimal?
  status         CashSessionStatus @default(OPEN)
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  movements      CashMovement[]    @relation("CashSessionMovements")
  closedBy       User?             @relation("CashSessionClosedBy", fields: [closedById], references: [id])
  openedBy       User              @relation("CashSessionOpenedBy", fields: [openedById], references: [id])
  cashRegister   CashRegister      @relation("CashRegisterSessions", fields: [cashRegisterId], references: [id])
  sales          Sale[]            @relation("CashSessionSales")
  @@index([cashRegisterId])
  @@index([status])
  @@index([openedAt])
}

model CashMovement {
  id            String           @id @default(uuid())
  cashSessionId String
  type          CashMovementType
  amount        Decimal
  description   String?
  createdById   String
  createdAt     DateTime         @default(now())
  createdBy     User             @relation("CashMovementCreatedBy", fields: [createdById], references: [id])
  cashSession   CashSession      @relation("CashSessionMovements", fields: [cashSessionId], references: [id])
  @@index([cashSessionId])
  @@index([type])
  @@index([createdAt])
  @@index([createdById])
}

model Sale {
  id             String        @id @default(uuid())
  saleNumber     String        @unique
  clientId       String?       @unique
  cashSessionId  String
  customerId     String?
  status         SaleStatus    @default(PENDING)
  subtotal       Decimal
  discountAmount Decimal       @default(0)
  totalAmount    Decimal
  paidAmount     Decimal       @default(0)
  changeAmount   Decimal       @default(0)
  notes          String?
  createdById    String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  createdBy      User          @relation("SaleCreatedBy", fields: [createdById], references: [id])
  customer       Customer?     @relation("SaleCustomer", fields: [customerId], references: [id])
  cashSession    CashSession   @relation("CashSessionSales", fields: [cashSessionId], references: [id])
  items          SaleItem[]    @relation("SaleItems")
  payments       SalePayment[] @relation("SalePayments")
  @@index([saleNumber])
  @@index([cashSessionId])
  @@index([status])
  @@index([createdAt])
  @@index([createdById])
}

model SaleItem {
  id             String   @id @default(uuid())
  saleId         String
  // Nulo para item avulso (não cadastrado no catálogo — ex.: laço sem
  // código de barras adicionado na hora da venda). Nesse caso productName
  // guarda o nome digitado e o estoque não é mexido.
  productId      String?
  productName    String?
  quantity       Int
  unitPrice      Decimal
  discountAmount Decimal  @default(0)
  totalAmount    Decimal
  createdAt      DateTime @default(now())
  product        Product? @relation("ProductSaleItems", fields: [productId], references: [id])
  sale           Sale     @relation("SaleItems", fields: [saleId], references: [id])
  @@index([saleId])
  @@index([productId])
  @@index([createdAt])
}

model SalePayment {
  id               String        @id @default(uuid())
  saleId           String
  method           PaymentMethod
  amount           Decimal
  status           PaymentStatus @default(PENDING)
  transactionId    String?
  processingFee    Decimal?
  installmentCount Int?
  changeAmount     Decimal?
  notes            String?
  processedById    String
  refundedAt       DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  processedBy      User          @relation("SalePaymentProcessedBy", fields: [processedById], references: [id])
  sale             Sale          @relation("SalePayments", fields: [saleId], references: [id])
  @@index([saleId])
  @@index([method])
  @@index([status])
  @@index([processedById])
  @@index([createdAt])
}

model PriceHistory {
  id            String   @id @default(uuid())
  productId     String
  previousPrice Decimal
  newPrice      Decimal
  changedById   String
  reason        String?
  changedAt     DateTime @default(now())
  changedBy     User     @relation("PriceHistoryChangedBy", fields: [changedById], references: [id])
  product       Product  @relation("ProductPriceHistory", fields: [productId], references: [id])
  @@index([productId])
  @@index([changedAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String
  metadata  Json?
  createdAt DateTime @default(now())
  user      User?    @relation("AuditLogUser", fields: [userId], references: [id])
  @@index([userId])
  @@index([entity])
  @@index([entityId])
  @@index([createdAt])
}

model Product {
  id                 String              @id @default(uuid())
  name               String
  description        String?
  sku                String              @unique
  barcode            String?             @unique
  categoryId         String
  supplierId         String?
  costPrice          Decimal             @default(0)
  salePrice          Decimal             @default(0)
  stockQuantity      Int                 @default(0)
  minStockLevel      Int                 @default(5)
  maxStockLevel      Int                 @default(1000)
  status             ProductStatus       @default(ACTIVE)
  isFeatured         Boolean             @default(false)
  unit               String              @default("unidade")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  priceHistories     PriceHistory[]      @relation("ProductPriceHistory")
  supplier           Supplier?           @relation("SupplierProducts", fields: [supplierId], references: [id])
  category           Category            @relation("CategoryProducts", fields: [categoryId], references: [id])
  purchaseOrderItems PurchaseOrderItem[] @relation("ProductPurchaseOrderItems")
  saleItems          SaleItem[]          @relation("ProductSaleItems")
  stockMovements     StockMovement[]     @relation("ProductStockMovements")
  label              ProductLabel?
  schoolListItems    SchoolListItem[]
  @@index([sku])
  @@index([barcode])
  @@index([categoryId])
  @@index([supplierId])
}

model StockMovement {
  id            String            @id @default(uuid())
  productId     String
  type          StockMovementType
  quantity      Int
  reference     String?
  notes         String?
  performedById String
  createdAt     DateTime          @default(now())
  performedBy   User              @relation("StockMovementPerformedBy", fields: [performedById], references: [id])
  product       Product           @relation("ProductStockMovements", fields: [productId], references: [id])
  @@index([productId])
  @@index([createdAt])
  @@index([performedById])
}

model Customer {
  id        String   @id @default(uuid())
  name      String
  email     String?  @unique
  phone     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sales     Sale[]   @relation("SaleCustomer")
  contacts  Contact[]
  @@index([name])
  @@index([email])
  @@index([phone])
}

model PurchaseOrder {
  id           String              @id @default(uuid())
  supplierId   String
  totalAmount  Decimal
  expectedDate DateTime?
  notes        String?
  status       PurchaseOrderStatus @default(PENDING)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  createdById  String
  updatedById  String?
  updatedBy    User?               @relation("PurchaseOrderUpdatedBy", fields: [updatedById], references: [id])
  createdBy    User                @relation("PurchaseOrderCreatedBy", fields: [createdById], references: [id])
  supplier     Supplier            @relation("SupplierPurchaseOrders", fields: [supplierId], references: [id])
  items        PurchaseOrderItem[] @relation("PurchaseOrderItems")
  @@index([supplierId])
  @@index([createdAt])
}

model PurchaseOrderItem {
  id              String        @id @default(uuid())
  purchaseOrderId String
  productId       String
  quantity        Int
  unitPrice       Decimal
  totalPrice      Decimal       @default(0)
  product         Product       @relation("ProductPurchaseOrderItems", fields: [productId], references: [id])
  purchaseOrder   PurchaseOrder @relation("PurchaseOrderItems", fields: [purchaseOrderId], references: [id])
  @@index([purchaseOrderId])
  @@index([productId])
}

enum Role {
  ADMIN
  MANAGER
  USER
  OWNER
  EMPLOYEE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DISCONTINUED
}

enum StockMovementType {
  PURCHASE
  SALE
  SALE_RETURN
  PURCHASE_RETURN
  LOSS
  THEFT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  CORRECTION
}

enum PurchaseOrderStatus {
  PENDING
  COMPLETED
  CANCELLED
  REFUNDED
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

enum CashMovementType {
  SALE
  OPENING
  WITHDRAWAL
  DEPOSIT
  ADJUSTMENT
}

enum SaleStatus {
  PENDING
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CASH
  PIX
  CREDIT_CARD
  DEBIT_CARD
}
/// Configurações da loja compartilhadas entre as máquinas (linha única id = "app").
model Settings {
  id                           String   @id @default("app")
  companyName                  String   @default("LAÇOLARIA")
  companyTagline               String   @default("Papelaria e Presentes")
  companyDoc                   String   @default("")
  companyAddress               String   @default("")
  companyPhone                 String   @default("")
  /// horário de funcionamento (texto livre) — usado pelo copiloto do atendimento
  storeHours                   String   @default("Segunda a sexta: 8h às 18h · Sábado: 8h às 13h")
  receiptFooter                String   @default("Obrigado pela preferencia! Troca em ate 7 dias com este comprovante.")
  receiptShowCompany           Boolean  @default(true)
  receiptWidth                 String   @default("80mm")
  cardInterestPercent          Float    @default(3.5)
  cardInterestFromInstallments Int      @default(2)
  /// Perfil da loja usado pela IA para sugerir preços (posicionamento, público, bairro).
  storeProfile                 String   @default("Papelaria nova, bem localizada, com curadoria e toque gourmet: produtos selecionados, atendimento caprichado e embalagem bonita. O cliente aceita pagar um pouco acima da média, desde que o preço seja justificável.")
  /// Cidade/UF para a pesquisa de preços considerar o mercado local.
  storeCity                    String   @default("")
  /// Chave da API do Claude (Anthropic). Nunca é devolvida pela API de configurações.
  aiApiKey                     String   @default("")
  /// nvidia | claude — quem lê a foto da lista e responde no ajudante
  aiProvider                   String   @default("nvidia")
  nvidiaApiKey                 String   @default("")
  nvidiaModel                  String   @default("nvidia/nemotron-3.5-super-vl-120b-a12b")
  aiModel                      String   @default("claude-sonnet-5")
  /// % acima do preço atual que dispara o aviso de "mercado em alta".
  priceAlertPercent            Float    @default(10)
  /// Fonte da pesquisa de preço: "shopping" (Google Shopping via SerpApi, grátis) ou "claude" (IA paga).
  priceProvider                String   @default("shopping")
  /// Chave da SerpApi (Google Shopping). Nunca é devolvida pela API de configurações.
  shoppingApiKey               String   @default("")
  /// "Toque da loja": quanto acima do preço médio de mercado sugerir (%).
  priceMarkupPercent           Float    @default(10)
  /// Meta de lucro sobre o custo (%), usada no cadastro e na importação.
  profitTargetPercent          Float    @default(110)
  /// Taxas da maquininha/banco (%), para mostrar quanto cai na conta.
  feeDebitPercent              Float    @default(0)
  feeCreditPercent             Float    @default(0)
  feeCreditInstallmentPercent  Float    @default(0)
  feePixPercent                Float    @default(0)
  /// Backup automático diário em arquivo local (em cada PC).
  backupEnabled                Boolean  @default(true)
  backupKeep                   Int      @default(30)
  /// Assistente do relatório do dia.
  reportReminderEnabled        Boolean  @default(true)
  reportReminderTime           String   @default("18:00")
  /// Fundo de troco padrão (dinheiro que já fica na gaveta ao abrir).
  cashFloatDefault             Float    @default(0)
  updatedAt                    DateTime @updatedAt
}

/// Conferência do fechamento do dia (dinheiro, cartão e Pix contados x sistema).
model DailyClosing {
  id           String   @id @default(uuid())
  /// Dia no formato AAAA-MM-DD (horário local da loja).
  date         String   @unique
  cashFloat    Decimal  @default(0)
  withdrawals  Decimal  @default(0)
  expectedCash Decimal  @default(0)
  expectedCard Decimal  @default(0)
  expectedPix  Decimal  @default(0)
  countedCash  Decimal?
  countedCard  Decimal?
  countedPix   Decimal?
  difference   Decimal  @default(0)
  notes        String?
  closedAt     DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// Resultado de uma pesquisa de preço de mercado feita pela IA.
model PriceCheck {
  id             String   @id @default(uuid())
  /// "shopping" ou "claude"
  provider       String?
  /// Produto do catálogo (sem FK: pesquisa pode ser feita antes do cadastro).
  productId      String?
  barcode        String?
  query          String
  productName    String?
  brand          String?
  currentPrice   Decimal?
  costPrice      Decimal?
  suggestedPrice Decimal?
  rangeMin       Decimal?
  rangeMax       Decimal?
  marketMin      Decimal?
  marketMedian   Decimal?
  marketMax      Decimal?
  direction      String?
  confidence     String?
  sources        Json?
  createdAt      DateTime @default(now())
  @@index([productId])
  @@index([barcode])
  @@index([createdAt])
}

/// Etiqueta de gôndola e promoção — tabela à parte para não mexer nas
/// colunas de Product (as consultas de produto do app inteiro continuam
/// iguais mesmo antes do banco ser atualizado). Ver schemaUpgrade.ts.
model ProductLabel {
  productId      String    @id
  /// "De R$ X" da promoção (o "por" é sempre o salePrice, que é o que o PDV cobra)
  compareAtPrice Decimal?
  /// último dia da promoção (inclusive); vazio = sem data para acabar
  promoUntil     DateTime?
  /// preço impresso na última etiqueta (para saber quando reimprimir)
  labelPrice     Decimal?
  /// "de" impresso na última etiqueta (0 = etiqueta sem promoção)
  labelCompareAt Decimal?
  labelPrintedAt DateTime?
  updatedAt      DateTime  @default(now()) @updatedAt
  product        Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
}

/// Escola cuja lista de material a loja salvou (ver savedListService.ts).
/// O slug junta grafias diferentes do mesmo nome ("Colégio São José" =
/// "colegio sao jose").
model School {
  id        String       @id @default(uuid())
  name      String
  slug      String       @unique
  active    Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  lists     SchoolList[]
}

/// Lista de material de uma série num ano letivo. O código curto ("L-3A7K")
/// vai no botão do site e na mensagem do WhatsApp — não muda quando a lista
/// é salva de novo. Preço e estoque não ficam gravados: o orçamento recalcula.
model SchoolList {
  id         String           @id @default(uuid())
  schoolId   String
  grade      String
  schoolYear Int
  code       String           @unique
  sourceText String           @default("")
  active     Boolean          @default(true)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  school     School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  items      SchoolListItem[]
  @@unique([schoolId, grade, schoolYear])
}

/// Item da lista salva; sem produto = "não temos".
model SchoolListItem {
  id        String     @id @default(uuid())
  listId    String
  position  Int
  raw       String
  text      String
  qty       Int
  productId String?
  list      SchoolList @relation(fields: [listId], references: [id], onDelete: Cascade)
  product   Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)
  @@index([listId])
  @@index([productId])
}

/// Contato do WhatsApp (robô e novidades). Telefone só com dígitos e DDI
/// ("5517999998888"). Só recebe novidades quem respondeu SIM (optInAt) e
/// não saiu depois (optOutAt). botPausedUntil: um atendente respondeu pelo
/// celular, o robô fica quieto nessa conversa até lá.
model Contact {
  id             String            @id @default(uuid())
  phone          String            @unique
  name           String?
  /// whatsapp | cliente | planilha
  source         String            @default("whatsapp")
  optInAt        DateTime?
  optOutAt       DateTime?
  optInAskedAt   DateTime?
  botPausedUntil DateTime?
  customerId     String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  customer       Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  messages       WhatsAppMessage[]
  recipients     BroadcastRecipient[]
}

/// Mensagem do WhatsApp (entrada e saída). metaId = id da Meta ("wamid..."),
/// único — é o que impede responder duas vezes quando a Meta reenvia.
model WhatsAppMessage {
  id        String   @id @default(uuid())
  metaId    String?  @unique
  contactId String
  /// in | out
  direction String
  /// text | image | template | other
  type      String
  body      String   @default("")
  /// received | sent | delivered | read | failed
  status    String   @default("received")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  @@index([contactId, createdAt])
}

/// Novidade enviada pelo WhatsApp do celular (lista de transmissão ou um por
/// um). Guarda o texto sem o rodapé de saída (entra na hora de enviar).
model Broadcast {
  id         String               @id @default(uuid())
  text       String
  createdAt  DateTime             @default(now())
  recipients BroadcastRecipient[]
}

/// Quem estava recebendo novidades quando o envio foi criado; sentAt = a
/// loja marcou que mandou.
model BroadcastRecipient {
  broadcastId String
  contactId   String
  sentAt      DateTime?
  broadcast   Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  contact     Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  @@id([broadcastId, contactId])
  @@index([contactId])
}

/// Orçamento pedido pelo cliente (copiloto do WhatsApp ou Lista Escolar).
/// Guarda o preço do momento; a tela mostra também o preço de agora.
model QuoteRequest {
  id        String   @id @default(uuid())
  name      String   @default("")
  phone     String?
  /// whatsapp | balcao
  source    String   @default("whatsapp")
  title     String   @default("")
  /// [{ qty, text, productId, price, take }] — price/take do momento do orçamento
  items     Json
  /// itens que a loja confirma (sem SKU, uniforme, não reconhecido)
  toConfirm Json     @default("[]")
  total     Decimal  @default(0)
  /// aberto | separado | retirado | cancelado
  status    String   @default("aberto")
  /// resposta enviada ao cliente (como foi montada)
  message   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([phone])
  @@index([createdAt])
  @@index([status])
}
