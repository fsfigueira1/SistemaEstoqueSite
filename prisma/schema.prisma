generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String          @id @default(uuid())
  name                    String
  email                   String          @unique
  password                String
  role                    Role
  status                  UserStatus      @default(ACTIVE)
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  auditLogs               AuditLog[]      @relation("AuditLogUser")
  cashMovementsCreated    CashMovement[]  @relation("CashMovementCreatedBy")
  cashSessionsClosed      CashSession[]   @relation("CashSessionClosedBy")
  cashSessionsOpened      CashSession[]   @relation("CashSessionOpenedBy")
  priceHistoryChanged     PriceHistory[]  @relation("PriceHistoryChangedBy")
  purchaseOrdersUpdated   PurchaseOrder[] @relation("PurchaseOrderUpdatedBy")
  purchaseOrdersCreated   PurchaseOrder[] @relation("PurchaseOrderCreatedBy")
  salesCreated            Sale[]          @relation("SaleCreatedBy")
  salePaymentsProcessed   SalePayment[]   @relation("SalePaymentProcessedBy")
  stockMovementsPerformed StockMovement[] @relation("StockMovementPerformedBy")
  @@index([email])
}

model Category {
  id          String    @id @default(uuid())
  name        String
  description String?
  icon        String?   @default("Tag")
  color       String?   @default("#6B7280")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[] @relation("CategoryProducts")
  @@index([name])
}

model Supplier {
  id             String          @id @default(uuid())
  name           String
  contactName    String?
  email          String?
  phone          String?
  address        String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  products       Product[]       @relation("SupplierProducts")
  purchaseOrders PurchaseOrder[] @relation("SupplierPurchaseOrders")
  @@index([name])
}

model CashRegister {
  id          String        @id @default(uuid())
  name        String
  description String?
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  sessions    CashSession[] @relation("CashRegisterSessions")
  @@index([name])
}

model CashSession {
  id             String            @id @default(uuid())
  cashRegisterId String
  openedById     String
  openedAt       DateTime
  openingAmount  Decimal
  closedById     String?
  closedAt       DateTime?
  expectedAmount Decimal?
  countedAmount  Decimal?
  difference     Decimal?
  status         CashSessionStatus @default(OPEN)
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  movements      CashMovement[]    @relation("CashSessionMovements")
  closedBy       User?             @relation("CashSessionClosedBy", fields: [closedById], references: [id])
  openedBy       User              @relation("CashSessionOpenedBy", fields: [openedById], references: [id])
  cashRegister   CashRegister      @relation("CashRegisterSessions", fields: [cashRegisterId], references: [id])
  sales          Sale[]            @relation("CashSessionSales")
  @@index([cashRegisterId])
  @@index([status])
  @@index([openedAt])
}

model CashMovement {
  id            String           @id @default(uuid())
  cashSessionId String
  type          CashMovementType
  amount        Decimal
  description   String?
  createdById   String
  createdAt     DateTime         @default(now())
  createdBy     User             @relation("CashMovementCreatedBy", fields: [createdById], references: [id])
  cashSession   CashSession      @relation("CashSessionMovements", fields: [cashSessionId], references: [id])
  @@index([cashSessionId])
  @@index([type])
  @@index([createdAt])
  @@index([createdById])
}

model Sale {
  id             String        @id @default(uuid())
  saleNumber     String        @unique
  cashSessionId  String
  customerId     String?
  status         SaleStatus    @default(PENDING)
  subtotal       Decimal
  discountAmount Decimal       @default(0)
  totalAmount    Decimal
  paidAmount     Decimal       @default(0)
  changeAmount   Decimal       @default(0)
  notes          String?
  createdById    String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  createdBy      User          @relation("SaleCreatedBy", fields: [createdById], references: [id])
  customer       Customer?     @relation("SaleCustomer", fields: [customerId], references: [id])
  cashSession    CashSession   @relation("CashSessionSales", fields: [cashSessionId], references: [id])
  items          SaleItem[]    @relation("SaleItems")
  payments       SalePayment[] @relation("SalePayments")
  @@index([saleNumber])
  @@index([cashSessionId])
  @@index([status])
  @@index([createdAt])
  @@index([createdById])
}

model SaleItem {
  id             String   @id @default(uuid())
  saleId         String
  productId      String
  quantity       Int
  unitPrice      Decimal
  discountAmount Decimal  @default(0)
  totalAmount    Decimal
  createdAt      DateTime @default(now())
  product        Product  @relation("ProductSaleItems", fields: [productId], references: [id])
  sale           Sale     @relation("SaleItems", fields: [saleId], references: [id])
  @@index([saleId])
  @@index([productId])
  @@index([createdAt])
}

model SalePayment {
  id               String        @id @default(uuid())
  saleId           String
  method           PaymentMethod
  amount           Decimal
  status           PaymentStatus @default(PENDING)
  transactionId    String?
  processingFee    Decimal?
  installmentCount Int?
  changeAmount     Decimal?
  notes            String?
  processedById    String
  refundedAt       DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  processedBy      User          @relation("SalePaymentProcessedBy", fields: [processedById], references: [id])
  sale             Sale          @relation("SalePayments", fields: [saleId], references: [id])
  @@index([saleId])
  @@index([method])
  @@index([status])
  @@index([processedById])
  @@index([createdAt])
}

model PriceHistory {
  id            String   @id @default(uuid())
  productId     String
  previousPrice Decimal
  newPrice      Decimal
  changedById   String
  reason        String?
  changedAt     DateTime @default(now())
  changedBy     User     @relation("PriceHistoryChangedBy", fields: [changedById], references: [id])
  product       Product  @relation("ProductPriceHistory", fields: [productId], references: [id])
  @@index([productId])
  @@index([changedAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String
  metadata  Json?
  createdAt DateTime @default(now())
  user      User?    @relation("AuditLogUser", fields: [userId], references: [id])
  @@index([userId])
  @@index([entity])
  @@index([entityId])
  @@index([createdAt])
}

model Product {
  id                 String              @id @default(uuid())
  name               String
  description        String?
  sku                String              @unique
  barcode            String?             @unique
  categoryId         String
  supplierId         String?
  costPrice          Decimal             @default(0)
  salePrice          Decimal             @default(0)
  stockQuantity      Int                 @default(0)
  minStockLevel      Int                 @default(5)
  maxStockLevel      Int                 @default(1000)
  status             ProductStatus       @default(ACTIVE)
  isFeatured         Boolean             @default(false)
  unit               String              @default("unidade")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  priceHistories     PriceHistory[]      @relation("ProductPriceHistory")
  supplier           Supplier?           @relation("SupplierProducts", fields: [supplierId], references: [id])
  category           Category            @relation("CategoryProducts", fields: [categoryId], references: [id])
  purchaseOrderItems PurchaseOrderItem[] @relation("ProductPurchaseOrderItems")
  saleItems          SaleItem[]          @relation("ProductSaleItems")
  stockMovements     StockMovement[]     @relation("ProductStockMovements")
  @@index([sku])
  @@index([barcode])
  @@index([categoryId])
  @@index([supplierId])
}

model StockMovement {
  id            String            @id @default(uuid())
  productId     String
  type          StockMovementType
  quantity      Int
  reference     String?
  notes         String?
  performedById String
  createdAt     DateTime          @default(now())
  performedBy   User              @relation("StockMovementPerformedBy", fields: [performedById], references: [id])
  product       Product           @relation("ProductStockMovements", fields: [productId], references: [id])
  @@index([productId])
  @@index([createdAt])
  @@index([performedById])
}

model Customer {
  id        String   @id @default(uuid())
  name      String
  email     String?  @unique
  phone     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sales     Sale[]   @relation("SaleCustomer")
  @@index([name])
  @@index([email])
  @@index([phone])
}

model PurchaseOrder {
  id           String              @id @default(uuid())
  supplierId   String
  totalAmount  Decimal
  expectedDate DateTime?
  notes        String?
  status       PurchaseOrderStatus @default(PENDING)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  createdById  String
  updatedById  String?
  updatedBy    User?               @relation("PurchaseOrderUpdatedBy", fields: [updatedById], references: [id])
  createdBy    User                @relation("PurchaseOrderCreatedBy", fields: [createdById], references: [id])
  supplier     Supplier            @relation("SupplierPurchaseOrders", fields: [supplierId], references: [id])
  items        PurchaseOrderItem[] @relation("PurchaseOrderItems")
  @@index([supplierId])
  @@index([createdAt])
}

model PurchaseOrderItem {
  id              String        @id @default(uuid())
  purchaseOrderId String
  productId       String
  quantity        Int
  unitPrice       Decimal
  totalPrice      Decimal       @default(0)
  product         Product       @relation("ProductPurchaseOrderItems", fields: [productId], references: [id])
  purchaseOrder   PurchaseOrder @relation("PurchaseOrderItems", fields: [purchaseOrderId], references: [id])
  @@index([purchaseOrderId])
  @@index([productId])
}

enum Role {
  ADMIN
  MANAGER
  USER
  OWNER
  EMPLOYEE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DISCONTINUED
}

enum StockMovementType {
  PURCHASE
  SALE
  SALE_RETURN
  PURCHASE_RETURN
  LOSS
  THEFT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  CORRECTION
}

enum PurchaseOrderStatus {
  PENDING
  COMPLETED
  CANCELLED
  REFUNDED
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

enum CashMovementType {
  SALE
  OPENING
  WITHDRAWAL
  DEPOSIT
  ADJUSTMENT
}

enum SaleStatus {
  PENDING
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CASH
  PIX
  CREDIT_CARD
  DEBIT_CARD
}